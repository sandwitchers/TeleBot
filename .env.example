# Telegram BotFather token
TELEGRAM_TOKEN=your_telegram_bot_token

# Your provider key. API_KEY is kept for compatibility with the original setup.
API_KEY=your_api_key
# OPENAI_API_KEY is also accepted when API_KEY is not set.

# OpenAI-compatible API endpoint and model
BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# Comma-separated numeric Telegram user IDs. Required; keeps the bot private.
ALLOWED_USERS=123456789

# Optional behavior
ALLOW_GROUPS=false
SYSTEM_PROMPT=Kamu adalah asisten AI yang jujur, helpful, dan langsung ke inti. Jawab dalam bahasa yang digunakan pengguna.

# Context and resource limits
MAX_INPUT_CHARS=12000
MAX_HISTORY_MESSAGES=20
MAX_CONTEXT_CHARS=30000
SESSION_TTL_HOURS=12
MAX_SESSIONS=500

# API behavior
API_TIMEOUT_MS=90000
API_MAX_RETRIES=2
# Set to 0 to let the model/provider use its default output limit.
MAX_TOKENS=0

# Railway injects PORT automatically. Do not set it manually there.
